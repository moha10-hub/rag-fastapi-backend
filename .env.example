# Copia questo file in ".env" e inserisci i tuoi valori.

# --- OpenAI (obbligatoria per l'LLM; obbligatoria anche per gli embeddings se EMBEDDING_PROVIDER=openai) ---
OPENAI_API_KEY=sk-inserisci-la-tua-chiave

# --- LLM ---
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# --- Embeddings: "openai" oppure "huggingface" ---
# Se cambi provider/modello usa anche un COLLECTION_NAME diverso:
# le dimensioni dei vettori non sono compatibili tra modelli diversi.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector DB (ChromaDB, persistenza su disco) ---
VECTOR_DB_DIR=./chroma_db
COLLECTION_NAME=documents

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=20

# --- Retrieval ---
RETRIEVER_K=4

# --- Applicazione ---
LOG_LEVEL=INFO
# Origini CORS separate da virgola. In produzione sostituisci "*" con i domini reali.
CORS_ORIGINS=*
